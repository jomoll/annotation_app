# ---- private / generated data: never commit ----
# Report text from CT-RATE (and most clinical corpora) is gated and may not be
# redistributed, and everything else here is rater PII or rating data.
data/cases.json
data/cases_*.json
data/raw/
data/accounts.json
data/assignments.json
data/progress.json
data/annotations/*
!data/annotations/.gitkeep
data/*.tmp
data/*.json.tmp
data/*_bak
data/assignments.*.json
# LLM cache of reporttools/llm.py: stores every prompt, i.e. report text
data/.llm_cache.sqlite*

# ---- python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ---- editors / OS ----
.vscode/
.idea/
.DS_Store

# research analyses live outside this repo (annotation + preprocessing only)
analysis/
